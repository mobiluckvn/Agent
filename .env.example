# Mẫu cấu hình biến môi trường — CHÉP thành .env rồi điền khóa thật.
#
#     cp .env.example .env
#
# Tệp .env nằm trong .gitignore và KHÔNG BAO GIỜ được commit. Có một test canh
# điều đó (tests/test_env_file.py) — nếu ai đó lỡ gỡ dòng ignore, test sẽ đỏ.
#
# NFR-06: khóa chỉ đi qua biến môi trường. Tệp này chỉ là chỗ nạp vào môi
# trường lúc chạy lệnh; adapter mô hình vẫn chỉ đọc os.environ, không đọc tệp.
# Biến đã đặt sẵn trong shell luôn THẮNG giá trị trong .env.

# Khóa API của mô hình nền. Lấy tại trang cấp khóa của nhà cung cấp.
EAA_LLM_KEY=

# Mã model, ghim phiên bản đầy đủ — không dùng bí danh kiểu "latest".
# Mã model của nhà cung cấp thay đổi theo thời gian; tra danh sách hiện hành
# rồi điền vào đây. Giá trị trong Project State (eaa init --model) thắng biến
# này nếu cả hai cùng có.
EAA_LLM_MODEL=gemini-3.1-pro-preview

# Tên người quyết định tại các Human Gate, ghi vào nhật ký quyết định.
EAA_ACTOR=Vũ Trí Công

# Thư mục cài đặt EAA và dự án đang làm việc (tùy chọn).
# EAA_HOME=/Users/v/Documents/KTDT
# EAA_PROJECT=/Users/v/Documents/KTDT/projects/robot_balance
